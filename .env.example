# CoraNotes — configuración local.
# Copiá este archivo como .env (en la misma carpeta) y completá tu clave.
# NUNCA compartas el archivo .env ni lo subas a Git.

# Clave de la API de Gemini (Google AI Studio). Sin clave, la app funciona en modo sin IA.
GEMINI_API_KEY=

# Modelo de Gemini. Verificado en la documentación oficial (octubre 2026) con nivel gratuito:
# gemini-3.8-flash (recomendado) o gemini-3.5-flash-lite (más liviano, suele tener más cuota).
# La disponibilidad y las cuotas dependen de tu cuenta y pueden cambiar.
GEMINI_MODEL=gemini-3.8-flash

# Puerto local (solo 127.0.0.1). Cambialo si 8765 está ocupado.
CORANOTES_PORT=8765

# Carpeta de datos (opcional). Por defecto: %LOCALAPPDATA%\CoraNotes
# CORANOTES_HOME=

# (Las variables viejas BITACORA_PORT y BITACORA_HOME siguen funcionando.)
